# Copy this file to .env and fill in your real values
# cp .env.example .env

# Get from @BotFather on Telegram (/newbot)
BOT_TOKEN=your_bot_token_here

# Get from @userinfobot on Telegram (numeric ID)
# This is the main Owner of the bot (can do everything)
OWNER_ID=your_telegram_id_here

# Add a secondary Admin ID here if you want someone else to help manage the bot
# (Leave this as 0 if you don't want a default admin)
ADMIN_ID=0
